+static nsresult ReadRegisteredProfileHostSelection(
+    nsToolkitProfileService* aService, nsIFile* mAppData, nsIFile* mTempData,
+    nsIFile* mProfileDBFile, nsIFile* mInstallDBFile, bool aCurrentBeforeRegistration,
+    const nsACString& aDescriptor, nsIFile** aAuthority, nsIFile** aLocal,
+    nsACString& aName, nsACString& aPath, nsACString& aIsRelative,
+    bool* aStoreIDPresent, nsACString& aStoreID, bool* aShowSelectorPresent,
+    nsACString& aShowSelector, nsIFile** aResult) {
+  NS_ENSURE_TRUE(aAuthority && aLocal && aStoreIDPresent &&
+                     aShowSelectorPresent && aResult, NS_ERROR_INVALID_ARG);
+  // No selection outputs are published before every fallible check/clone.
+  NS_ENSURE_TRUE(!aDescriptor.IsEmpty() &&
+                     aDescriptor.FindChar('\0') == kNotFound,
+                 NS_ERROR_INVALID_ARG);
+  nsCOMPtr<nsIFile> requestedRoot;
+  nsresult rv = NS_NewLocalFileWithPersistentDescriptor(
+      aDescriptor, getter_AddRefs(requestedRoot));
+  NS_ENSURE_SUCCESS(rv, rv);
+#ifndef MOZ_BACKGROUNDTASKS
+  return NS_ERROR_NOT_AVAILABLE;
+#else
+  NS_ENSURE_TRUE(mAppData && mTempData && mProfileDBFile && mInstallDBFile &&
+                     gDirServiceProvider,
+                 NS_ERROR_NOT_INITIALIZED);
+  rv = CheckRegisteredSelectionPath(mAppData);
+  NS_ENSURE_SUCCESS(rv, rv);
+  rv = CheckRegisteredSelectionPath(mProfileDBFile, true);
+  NS_ENSURE_SUCCESS(rv, rv);
+  rv = CheckRegisteredSelectionPath(mInstallDBFile, true, true);
+  NS_ENSURE_SUCCESS(rv, rv);
+  nsCOMPtr<nsIFile> manager;
+  rv = aService->GetZenCatalogProfileDirectory(getter_AddRefs(manager));
+  NS_ENSURE_SUCCESS(rv, rv);
+  // Only the explicit current-owner endpoint qualifies an absent registration.
+  // Ordinary registered-owner callers still require the existing catalog.
+  NS_ENSURE_TRUE(aCurrentBeforeRegistration ? !manager : !!manager,
+                 NS_ERROR_NOT_AVAILABLE);
+  if (manager) {
+    rv = CheckRegisteredSelectionPath(manager);
+    NS_ENSURE_SUCCESS(rv, rv);
+  }
+
+  IniFilePreimage profiles, installs;
+  rv = ReadIniFile(mProfileDBFile, profiles, /* aStrictQuery */ true);
+  NS_ENSURE_SUCCESS(rv, rv);
+  rv = ReadIniFile(mInstallDBFile, installs, /* aStrictQuery */ true);
+  NS_ENSURE_SUCCESS(rv, rv);
+  NS_ENSURE_TRUE(profiles.mExists, NS_ERROR_NOT_AVAILABLE);
+  nsString installHash;
+  rv = gDirServiceProvider->GetInstallHash(installHash);
+  NS_ENSURE_SUCCESS(rv, rv);
+  nsCString catalogKey = BackgroundTasks::GetProfilePrefix(
+      NS_LossyConvertUTF16toASCII(installHash), "zen_catalog"_ns);
+  rv = CheckRegisteredSelectionDuplicates(profiles.mBytes, catalogKey);
+  NS_ENSURE_SUCCESS(rv, rv);
+  bool containedErrors = false;
+  if (installs.mExists) {
+    nsINIParser installDB;
+    rv = installDB.InitFromString(installs.mBytes, &containedErrors);
+    NS_ENSURE_SUCCESS(rv, rv);
+    NS_ENSURE_TRUE(!containedErrors, NS_ERROR_NOT_AVAILABLE);
+  }
+  nsINIParser profileDB;
+  rv = profileDB.InitFromString(profiles.mBytes, &containedErrors);
+  NS_ENSURE_SUCCESS(rv, rv);
+  NS_ENSURE_TRUE(!containedErrors, NS_ERROR_NOT_AVAILABLE);
+  nsTArray<nsCString> sections;
+  profileDB.GetSections([&](const char* aSection) {
+    nsDependentCString section(aSection);
+    if (IsRegisteredProfileSection(section)) {
+      sections.AppendElement(section);
+    }
+    return true;
+  });
+  struct Selection {
+    nsCOMPtr<nsIFile> root, local;
+    nsCString name, path, isRelative, storeID, showSelector;
+    bool storeIDPresent = false, showSelectorPresent = false;
+  };
+  nsTArray<Selection> selections;
+  size_t matched = 0;
+  bool found = false;
+  for (const auto& section : sections) {
+    Selection selection;
+    rv = profileDB.GetString(section.get(), "Name", selection.name);
+    NS_ENSURE_SUCCESS(rv, rv);
+    rv = profileDB.GetString(section.get(), "Path", selection.path);
+    NS_ENSURE_SUCCESS(rv, rv);
+    rv = profileDB.GetString(section.get(), "IsRelative", selection.isRelative);
+    NS_ENSURE_SUCCESS(rv, rv);
+    NS_ENSURE_TRUE(!selection.path.IsEmpty() &&
+                       (selection.isRelative.EqualsLiteral("0") ||
+                        selection.isRelative.EqualsLiteral("1")),
+                   NS_ERROR_NOT_AVAILABLE);
+    rv = profileDB.GetString(section.get(), "StoreID", selection.storeID);
+    selection.storeIDPresent = rv != NS_ERROR_FAILURE;
+    if (selection.storeIDPresent) {
+      NS_ENSURE_SUCCESS(rv, rv);
+    }
+    rv = profileDB.GetString(section.get(), "ShowSelector", selection.showSelector);
+    selection.showSelectorPresent = rv != NS_ERROR_FAILURE;
+    if (selection.showSelectorPresent) {
+      NS_ENSURE_SUCCESS(rv, rv);
+    }
+    if (selection.isRelative.EqualsLiteral("1")) {
+      rv = NS_NewLocalFileWithRelativeDescriptor(
+          mAppData, selection.path, getter_AddRefs(selection.root));
+    } else {
+      rv = NS_NewLocalFileWithPersistentDescriptor(
+          selection.path, getter_AddRefs(selection.root));
+    }
+    NS_ENSURE_SUCCESS(rv, rv);
+    rv = CheckRegisteredSelectionPath(selection.root);
+    NS_ENSURE_SUCCESS(rv, rv);
+    nsCOMPtr<nsIFile> root;
+    rv = NormalizeCatalogPath(selection.root, getter_AddRefs(root));
+    NS_ENSURE_SUCCESS(rv, rv);
+    selection.root = root;
+    rv = aService->GetLocalDirFromRootDir(root, getter_AddRefs(selection.local));
+    NS_ENSURE_SUCCESS(rv, rv);
+    rv = CheckRegisteredSelectionPath(selection.local);
+    NS_ENSURE_SUCCESS(rv, rv);
+    nsCOMPtr<nsIFile> local;
+    rv = NormalizeCatalogPath(selection.local, getter_AddRefs(local));
+    NS_ENSURE_SUCCESS(rv, rv);
+    selection.local = local;
+    // Reject catalog overlap and aliases/ancestry across registered owners,
+    // including root-local cross aliases. A profile may use its own root locally.
+    for (nsIFile* directory : {root.get(), local.get()}) {
+      bool overlaps;
+      if (manager) {
+        rv = IsCatalogAncestor(manager, directory, &overlaps);
+        NS_ENSURE_SUCCESS(rv, rv);
+        NS_ENSURE_TRUE(!overlaps, NS_ERROR_NOT_AVAILABLE);
+        rv = IsCatalogAncestor(directory, manager, &overlaps);
+        NS_ENSURE_SUCCESS(rv, rv);
+        NS_ENSURE_TRUE(!overlaps, NS_ERROR_NOT_AVAILABLE);
+      }
+      for (const auto& previous : selections) {
+        for (nsIFile* known : {previous.root.get(), previous.local.get()}) {
+          rv = IsCatalogAncestor(known, directory, &overlaps);
+          NS_ENSURE_SUCCESS(rv, rv);
+          NS_ENSURE_TRUE(!overlaps, NS_ERROR_NOT_AVAILABLE);
+          rv = IsCatalogAncestor(directory, known, &overlaps);
+          NS_ENSURE_SUCCESS(rv, rv);
+          NS_ENSURE_TRUE(!overlaps, NS_ERROR_NOT_AVAILABLE);
+        }
+      }
+    }
+    nsCString descriptor;
+    rv = root->GetPersistentDescriptor(descriptor);
+    NS_ENSURE_SUCCESS(rv, rv);
+    if (descriptor.Equals(aDescriptor)) {
+      bool equals;
+      rv = root->Equals(requestedRoot, &equals);
+      NS_ENSURE_SUCCESS(rv, rv);
+      NS_ENSURE_TRUE(equals, NS_ERROR_NOT_AVAILABLE);
+      NS_ENSURE_TRUE(!found, NS_ERROR_NOT_AVAILABLE);
+      found = true;
+      matched = selections.Length();
+    }
+    selections.AppendElement(std::move(selection));
+  }
+  NS_ENSURE_TRUE(found, NS_ERROR_NOT_AVAILABLE);
+  const auto& selection = selections[matched];
+  nsCOMPtr<nsIFile> authority, root, local;
+  rv = mAppData->Clone(getter_AddRefs(authority));
+  NS_ENSURE_SUCCESS(rv, rv);
+  rv = selection.root->Clone(getter_AddRefs(root));
+  NS_ENSURE_SUCCESS(rv, rv);
+  rv = selection.local->Clone(getter_AddRefs(local));
+  NS_ENSURE_SUCCESS(rv, rv);
+  // Sequential verification, not an atomic registry pair, lock or authentication.
+  nsCOMPtr<nsIFile> verifiedManager;
+  rv = aService->GetZenCatalogProfileDirectory(getter_AddRefs(verifiedManager));
+  NS_ENSURE_SUCCESS(rv, rv);
+  NS_ENSURE_TRUE(aCurrentBeforeRegistration ? !verifiedManager : !!verifiedManager,
+                 NS_ERROR_DATABASE_CHANGED);
+  bool equals;
+  if (manager) {
+    rv = manager->Equals(verifiedManager, &equals);
+    NS_ENSURE_SUCCESS(rv, rv);
+    NS_ENSURE_TRUE(equals, NS_ERROR_DATABASE_CHANGED);
+  } else {
+    // ProfD/ProfLD are the running owner's directories, not resident mCurrent.
+    nsCOMPtr<nsIFile> currentRoot, currentLocal;
+    rv = NS_GetSpecialDirectory(NS_APP_USER_PROFILE_50_DIR,
+                                getter_AddRefs(currentRoot));
+    NS_ENSURE_SUCCESS(rv, rv);
+    rv = NS_GetSpecialDirectory(NS_APP_USER_PROFILE_LOCAL_50_DIR,
+                                getter_AddRefs(currentLocal));
+    NS_ENSURE_SUCCESS(rv, rv);
+    rv = root->Equals(currentRoot, &equals);
+    NS_ENSURE_SUCCESS(rv, rv);
+    NS_ENSURE_TRUE(equals, NS_ERROR_DATABASE_CHANGED);
+    rv = local->Equals(currentLocal, &equals);
+    NS_ENSURE_SUCCESS(rv, rv);
+    NS_ENSURE_TRUE(equals, NS_ERROR_DATABASE_CHANGED);
+  }
+  rv = CheckRegisteredSelectionPath(mProfileDBFile, true);
+  NS_ENSURE_SUCCESS(rv, rv);
+  rv = CheckRegisteredSelectionPath(mInstallDBFile, true, true);
+  NS_ENSURE_SUCCESS(rv, rv);
+  if (manager) {
+    rv = CheckRegisteredSelectionPath(manager);
+    NS_ENSURE_SUCCESS(rv, rv);
+  }
+  for (const auto& admitted : selections) {
+    for (nsIFile* directory : {admitted.root.get(), admitted.local.get()}) {
+      rv = CheckRegisteredSelectionPath(directory);
+      NS_ENSURE_SUCCESS(rv, rv);
+      nsCOMPtr<nsIFile> canonical;
+      rv = NormalizeCatalogPath(directory, getter_AddRefs(canonical));
+      NS_ENSURE_SUCCESS(rv, rv);
+      rv = directory->Equals(canonical, &equals);
+      NS_ENSURE_SUCCESS(rv, rv);
+      NS_ENSURE_TRUE(equals, NS_ERROR_DATABASE_CHANGED);
+    }
+    nsCOMPtr<nsIFile> mappedLocal, canonicalLocal;
+    rv = aService->GetLocalDirFromRootDir(admitted.root, getter_AddRefs(mappedLocal));
+    NS_ENSURE_SUCCESS(rv, rv);
+    rv = NormalizeCatalogPath(mappedLocal, getter_AddRefs(canonicalLocal));
+    NS_ENSURE_SUCCESS(rv, rv);
+    rv = admitted.local->Equals(canonicalLocal, &equals);
+    NS_ENSURE_SUCCESS(rv, rv);
+    NS_ENSURE_TRUE(equals, NS_ERROR_DATABASE_CHANGED);
+  }
+  rv = CheckRegisteredSelectionPath(authority);
+  NS_ENSURE_SUCCESS(rv, rv);
+  IniFilePreimage verifiedProfiles, verifiedInstalls;
+  rv = ReadIniFile(mProfileDBFile, verifiedProfiles, /* aStrictQuery */ true);
+  NS_ENSURE_SUCCESS(rv, rv);
+  rv = ReadIniFile(mInstallDBFile, verifiedInstalls, /* aStrictQuery */ true);
+  NS_ENSURE_SUCCESS(rv, rv);
+  NS_ENSURE_TRUE(verifiedProfiles.mExists == profiles.mExists &&
+                     verifiedProfiles.mBytes.Equals(profiles.mBytes) &&
+                     verifiedInstalls.mExists == installs.mExists &&
+                     verifiedInstalls.mBytes.Equals(installs.mBytes),
+                 NS_ERROR_DATABASE_CHANGED);
+  // Raw literals and explicit presence, never GetProfileDescriptor serialization.
+  aName = selection.name;
+  aPath = selection.path;
+  aIsRelative = selection.isRelative;
+  *aStoreIDPresent = selection.storeIDPresent;
+  aStoreID = selection.storeID;
+  *aShowSelectorPresent = selection.showSelectorPresent;
+  aShowSelector = selection.showSelector;
+  authority.forget(aAuthority);
+  local.forget(aLocal);
+  root.forget(aResult);
+  return NS_OK;
+#endif
+}
