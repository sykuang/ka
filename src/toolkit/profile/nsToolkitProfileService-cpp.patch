+NS_IMETHODIMP
+nsToolkitProfileService::AdoptZenCatalogProfileRegistration(
+    nsIFile* aExpectedRoot) {
+#ifndef MOZ_BACKGROUNDTASKS
+  return NS_ERROR_NOT_AVAILABLE;
+#else
+  NS_ENSURE_TRUE(aExpectedRoot, NS_ERROR_INVALID_ARG);
+  NS_ENSURE_TRUE(mAppData && mProfileDBFile && mInstallDBFile &&
+                     gDirServiceProvider,
+                 NS_ERROR_NOT_INITIALIZED);
+  ProfileRegistryLease lease;
+  nsresult rv = lease.Init(mAppData);
+  NS_ENSURE_SUCCESS(rv, rv);
+  MutexAutoLock lock(mRegistryDataMutex);
+  NS_ENSURE_TRUE(!mProfileDBReadFailed, NS_ERROR_NOT_AVAILABLE);
+  NS_ENSURE_SUCCESS(mFullFlushReadResult, mFullFlushReadResult);
+
+  IniFilePreimage profiles;
+  IniFilePreimage installs;
+  rv = ReadIniFile(mProfileDBFile, profiles, /* aStrictQuery */ true);
+  NS_ENSURE_SUCCESS(rv, rv);
+  rv = ReadIniFile(mInstallDBFile, installs, /* aStrictQuery */ true);
+  NS_ENSURE_SUCCESS(rv, rv);
+  NS_ENSURE_TRUE(profiles.mExists && mProfileDBPreimage.mExists &&
+                     installs.mExists == mInstallDBPreimage.mExists &&
+                     installs.mBytes.Equals(mInstallDBPreimage.mBytes),
+                 NS_ERROR_DATABASE_CHANGED);
+  nsINIParser baselineDB;
+  nsINIParser freshDB;
+  bool containedErrors = false;
+  rv = baselineDB.InitFromString(mProfileDBPreimage.mBytes, &containedErrors);
+  NS_ENSURE_SUCCESS(rv, rv);
+  NS_ENSURE_TRUE(!containedErrors, NS_ERROR_DATABASE_CHANGED);
+  rv = freshDB.InitFromString(profiles.mBytes, &containedErrors);
+  NS_ENSURE_SUCCESS(rv, rv);
+  NS_ENSURE_TRUE(!containedErrors, NS_ERROR_DATABASE_CHANGED);
+  nsString installHash;
+  rv = gDirServiceProvider->GetInstallHash(installHash);
+  NS_ENSURE_SUCCESS(rv, rv);
+  nsCString profilePrefix = BackgroundTasks::GetProfilePrefix(
+      NS_LossyConvertUTF16toASCII(installHash), "zen_catalog"_ns);
+  nsCString leaf;
+  rv = baselineDB.GetString("BackgroundTasksProfiles", profilePrefix.get(), leaf);
+  NS_ENSURE_TRUE(rv == NS_ERROR_FAILURE, NS_ERROR_DATABASE_CHANGED);
+  rv = freshDB.GetString("BackgroundTasksProfiles", profilePrefix.get(), leaf);
+  NS_ENSURE_SUCCESS(rv, rv);
+  rv = baselineDB.SetString("BackgroundTasksProfiles", profilePrefix.get(),
+                             leaf.get());
+  NS_ENSURE_SUCCESS(rv, rv);
+  // Compare every semantic field in both directions. Only the expected task key
+  // may be added; even General-only peer changes remain stale in this browser.
+  for (nsINIParser* parser : {&baselineDB, &freshDB}) {
+    nsINIParser* other = parser == &baselineDB ? &freshDB : &baselineDB;
+    bool matches = true;
+    parser->GetSections([&](const char* aSection) {
+      for (const auto& kv : GetSectionStrings(parser, aSection)) {
+        nsCString value;
+        matches =
+            NS_SUCCEEDED(other->GetString(aSection, kv->key.get(), value)) &&
+            value.Equals(kv->value);
+        if (!matches) {
+          return false;
+        }
+      }
+      return true;
+    });
+    NS_ENSURE_TRUE(matches, NS_ERROR_DATABASE_CHANGED);
+  }
+  nsCOMPtr<nsIFile> registered;
+  rv = GetZenCatalogProfileDirectory(getter_AddRefs(registered));
+  NS_ENSURE_SUCCESS(rv, rv);
+  NS_ENSURE_TRUE(registered, NS_ERROR_NOT_AVAILABLE);
+  bool equals;
+  rv = registered->Equals(aExpectedRoot, &equals);
+  NS_ENSURE_SUCCESS(rv, rv);
+  NS_ENSURE_TRUE(equals, NS_ERROR_DATABASE_CHANGED);
+
+  // Publish observation only after all fallible reads succeed. The original
+  // parsed cache and BOTH full-writer preimages deliberately remain unchanged:
+  // a subsequent whole-registry flush must still refuse this external delta.
+  bool exists;
+  PRTime modifiedTime;
+  int64_t size;
+  rv = UpdateFileStats(mProfileDBFile, &exists, &modifiedTime, &size);
+  NS_ENSURE_SUCCESS(rv, rv);
+  IniFilePreimage verifiedProfiles;
+  IniFilePreimage verifiedInstalls;
+  rv = ReadIniFile(mProfileDBFile, verifiedProfiles, /* aStrictQuery */ true);
+  NS_ENSURE_SUCCESS(rv, rv);
+  rv = ReadIniFile(mInstallDBFile, verifiedInstalls, /* aStrictQuery */ true);
+  NS_ENSURE_SUCCESS(rv, rv);
+  NS_ENSURE_TRUE(exists && size == int64_t(profiles.mBytes.Length()) &&
+                     verifiedProfiles.mExists == profiles.mExists &&
+                     verifiedProfiles.mBytes.Equals(profiles.mBytes) &&
+                     verifiedInstalls.mExists == installs.mExists &&
+                     verifiedInstalls.mBytes.Equals(installs.mBytes),
+                 NS_ERROR_DATABASE_CHANGED);
+  mProfileDBExists = exists;
+  mProfileDBModifiedTime = modifiedTime;
+  mProfileDBFileSize = size;
+  return NS_OK;
+#endif
 }
 
