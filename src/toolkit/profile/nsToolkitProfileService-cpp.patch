+// Identity-only preflight: nsINIParser merges repeated sections and overwrites
+// keys without containedErrors. Mirror its BOM/token boundaries, NOT its value
+// parser. The existing parser below still owns syntax errors and all values.
+static nsresult CheckRegisteredSelectionDuplicates(const nsCString& aBytes,
+                                                   const nsCString& aCatalogKey) {
+  nsCString contents;
+  char* buffer;
+  if (StringHead(aBytes, 3) == "\xEF\xBB\xBF") {
+    contents.Append(aBytes);
+    buffer = contents.BeginWriting() + 3;
+  } else {
+    if (StringHead(aBytes, 2) == "\xFF\xFE") {
+      nsDependentSubstring str(reinterpret_cast<const char16_t*>(aBytes.get()),
+                               aBytes.Length() / 2);
+      AppendUTF16toUTF8(Substring(str, 1), contents);
+    } else {
+      contents.Append(aBytes);
+    }
+    buffer = contents.BeginWriting();
+  }
+  nsTArray<nsCString> sections, identities;
+  char* section = nullptr;
+  while (char* token = NS_strtok("\r\n", &buffer)) {
+    if (token[0] == '#' || token[0] == ';') {
+      continue;
+    }
+    token = (char*)NS_strspnp(" \t", token);
+    if (!*token) {
+      continue;
+    }
+    if (token[0] == '[') {
+      section = ++token;
+      char* rb = NS_strtok("]", &token);
+      if (!rb || NS_strtok(" \t", &token)) {
+        section = nullptr;
+      } else if (IsRegisteredProfileSection(nsDependentCString(section))) {
+        nsDependentCString name(section);
+        NS_ENSURE_TRUE(!sections.Contains(name), NS_ERROR_NOT_AVAILABLE);
+        sections.AppendElement(name);
+      }
+      continue;
+    }
+    if (!section) {
+      continue;
+    }
+    char* key = token;
+    char* e = NS_strtok("=", &token);
+    if (!e || !token) {
+      continue;
+    }
+    nsDependentCString name(section), field(key);
+    if ((IsRegisteredProfileSection(name) &&
+         (field.EqualsLiteral("Name") || field.EqualsLiteral("Path") ||
+          field.EqualsLiteral("IsRelative") || field.EqualsLiteral("StoreID") ||
+          field.EqualsLiteral("ShowSelector"))) ||
+        (name.EqualsLiteral("BackgroundTasksProfiles") && field.Equals(aCatalogKey))) {
+      nsCString identity(name);
+      identity.Append('\n');
+      identity.Append(field);
+      NS_ENSURE_TRUE(!identities.Contains(identity), NS_ERROR_NOT_AVAILABLE);
+      identities.AppendElement(identity);
+    }
+  }
+  return NS_OK;
+}
