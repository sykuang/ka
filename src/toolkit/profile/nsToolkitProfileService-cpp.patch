+static nsresult ReadIniFile(nsIFile* aFile, IniFilePreimage& aPreimage,
+                            bool aStrictQuery = false) {
+  nsCOMPtr<nsIFile> file;
+  nsresult rv = aFile->Clone(getter_AddRefs(file));
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  IniFilePreimage preimage;
+  if (aStrictQuery) {
+    // Exists can collapse query errno into absence; discovery must not.
+    rv = file->IsFile(&preimage.mExists);
+    if (rv == NS_ERROR_FILE_NOT_FOUND) {
+      preimage.mExists = false;
+    } else {
+      NS_ENSURE_SUCCESS(rv, rv);
+      NS_ENSURE_TRUE(preimage.mExists, NS_ERROR_FAILURE);
+    }
+  } else {
+    rv = file->Exists(&preimage.mExists);
+    NS_ENSURE_SUCCESS(rv, rv);
+  }
+  if (preimage.mExists) {
+    if (!aStrictQuery) {
+      bool isFile;
+      rv = file->IsFile(&isFile);
+      NS_ENSURE_SUCCESS(rv, rv);
+      NS_ENSURE_TRUE(isFile, NS_ERROR_FAILURE);
+    }
+
+    nsCOMPtr<nsIFileInputStream> stream = new nsFileInputStream();
+    rv = stream->Init(file, -1, -1, 0);
+    NS_ENSURE_SUCCESS(rv, rv);
+    auto closeStream = MakeScopeExit([&] { stream->Close(); });
+    rv = NS_ConsumeStream(stream, UINT32_MAX, preimage.mBytes);
+    NS_ENSURE_SUCCESS(rv, rv);
+
+    char extra;
+    uint32_t count;
+    rv = stream->Read(&extra, 1, &count);
+    NS_ENSURE_SUCCESS(rv, rv);
+    NS_ENSURE_TRUE(count == 0, NS_ERROR_FILE_TOO_BIG);
+    rv = stream->Close();
+    closeStream.release();
+    NS_ENSURE_SUCCESS(rv, rv);
+  }
+  aPreimage = std::move(preimage);
+  return NS_OK;
+}
