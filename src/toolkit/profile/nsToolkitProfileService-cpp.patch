+class MOZ_RAII ProfileRegistryLease final {
+ public:
+  ProfileRegistryLease() : mProcessLock(sProfileRegistryMutex) {}
+
+  nsresult Init(nsIFile* aAppData) {
+    if (!mProcessLock) {
+      return NS_ERROR_FILE_ACCESS_DENIED;
+    }
+
+    nsCOMPtr<nsIFile> site;
+    nsresult rv = aAppData->Clone(getter_AddRefs(site));
+    NS_ENSURE_SUCCESS(rv, rv);
+    rv = site->AppendNative(".zen-profile-registry-lock"_ns);
+    NS_ENSURE_SUCCESS(rv, rv);
+    rv = RejectSymlink(site);
+    NS_ENSURE_SUCCESS(rv, rv);
+
+    bool isDir;
+    rv = site->IsDirectory(&isDir);
+    if (rv == NS_ERROR_FILE_NOT_FOUND) {
+      rv = site->Create(nsIFile::DIRECTORY_TYPE, 0700);
+      if (NS_FAILED(rv) && rv != NS_ERROR_FILE_ALREADY_EXISTS) {
+        return rv;
+      }
+      rv = RejectSymlink(site);
+      NS_ENSURE_SUCCESS(rv, rv);
+      rv = site->IsDirectory(&isDir);
+    }
+    NS_ENSURE_SUCCESS(rv, rv);
+    NS_ENSURE_TRUE(isDir, NS_ERROR_FILE_NOT_DIRECTORY);
+
+    nsCOMPtr<nsIFile> lockFile;
+    rv = site->Clone(getter_AddRefs(lockFile));
+    NS_ENSURE_SUCCESS(rv, rv);
+#if defined(XP_UNIX)
+    rv = lockFile->AppendNative(".parentlock"_ns);
+#else
+    rv = lockFile->AppendNative("parent.lock"_ns);
+#endif
+    NS_ENSURE_SUCCESS(rv, rv);
+    rv = RejectSymlink(lockFile);
+    NS_ENSURE_SUCCESS(rv, rv);
+    bool isFile;
+    rv = lockFile->IsFile(&isFile);
+    if (rv != NS_ERROR_FILE_NOT_FOUND) {
+      NS_ENSURE_SUCCESS(rv, rv);
+      NS_ENSURE_TRUE(isFile, NS_ERROR_FILE_ACCESS_DENIED);
+    }
+
+    rv = mFileLock.Lock(site, nullptr, false);
+    NS_ENSURE_SUCCESS(rv, rv);
+    rv = RejectSymlink(lockFile);
+    NS_ENSURE_SUCCESS(rv, rv);
+    rv = lockFile->IsFile(&isFile);
+    NS_ENSURE_SUCCESS(rv, rv);
+    NS_ENSURE_TRUE(isFile, NS_ERROR_FILE_ACCESS_DENIED);
+    mAppData = aAppData;
+    return NS_OK;
+  }
+
+  bool IsHeldFor(nsIFile* aAppData) const {
+    sProfileRegistryMutex.AssertCurrentThreadOwns();
+    return mAppData == aAppData;
+  }
+
+ private:
+  static nsresult RejectSymlink(nsIFile* aFile) {
+    bool isLink;
+    nsresult rv = aFile->IsSymlink(&isLink);
+    if (rv == NS_ERROR_FILE_NOT_FOUND) {
+      return NS_OK;
+    }
+    NS_ENSURE_SUCCESS(rv, rv);
+    return isLink ? NS_ERROR_FILE_ACCESS_DENIED : NS_OK;
+  }
+
+  // fcntl locks are process-scoped: close the descriptor before the mutex.
+  StaticMutexAutoTryLock mProcessLock;
+  nsProfileLock mFileLock;
+  nsIFile* mAppData = nullptr;
+};
 
