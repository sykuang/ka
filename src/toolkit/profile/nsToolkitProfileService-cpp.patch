+NS_IMETHODIMP
+nsToolkitProfileService::GetZenCatalogProfileDirectory(nsIFile** aResult) {
+  *aResult = nullptr;
+#ifndef MOZ_BACKGROUNDTASKS
+  return NS_ERROR_NOT_AVAILABLE;
+#else
+  NS_ENSURE_TRUE(mAppData && mProfileDBFile && mInstallDBFile &&
+                     gDirServiceProvider,
+                 NS_ERROR_NOT_INITIALIZED);
+  IniFilePreimage profiles;
+  IniFilePreimage installs;
+  nsresult rv = ReadIniFile(mProfileDBFile, profiles, /* aStrictQuery */ true);
+  NS_ENSURE_SUCCESS(rv, rv);
+  rv = ReadIniFile(mInstallDBFile, installs, /* aStrictQuery */ true);
+  NS_ENSURE_SUCCESS(rv, rv);
+  bool containedErrors = false;
+  if (installs.mExists) {
+    nsINIParser installDB;
+    rv = installDB.InitFromString(installs.mBytes, &containedErrors);
+    NS_ENSURE_SUCCESS(rv, rv);
+    NS_ENSURE_TRUE(!containedErrors, NS_ERROR_NOT_AVAILABLE);
+  }
+  if (!profiles.mExists) {
+    return NS_OK;
+  }
+  nsINIParser profileDB;
+  rv = profileDB.InitFromString(profiles.mBytes, &containedErrors);
+  NS_ENSURE_SUCCESS(rv, rv);
+  NS_ENSURE_TRUE(!containedErrors, NS_ERROR_NOT_AVAILABLE);
+  nsString installHash;
+  rv = gDirServiceProvider->GetInstallHash(installHash);
+  NS_ENSURE_SUCCESS(rv, rv);
+  nsCString profilePrefix = BackgroundTasks::GetProfilePrefix(
+      NS_LossyConvertUTF16toASCII(installHash), "zen_catalog"_ns);
+  nsCString leaf;
+  rv = profileDB.GetString("BackgroundTasksProfiles", profilePrefix.get(), leaf);
+  if (rv == NS_ERROR_FAILURE) {
+    return NS_OK;
+  }
+  NS_ENSURE_SUCCESS(rv, rv);
+  NS_ENSURE_TRUE(!leaf.IsEmpty() && leaf.Length() == profilePrefix.Length() + 9 &&
+                     leaf.CharAt(8) == '.' && StringEndsWith(leaf, profilePrefix) &&
+                     leaf.FindChar('/') == kNotFound &&
+                     leaf.FindChar('\\') == kNotFound,
+                 NS_ERROR_NOT_AVAILABLE);
+  for (uint32_t i = 0; i < 8; ++i) {
+    char c = leaf.CharAt(i);
+    NS_ENSURE_TRUE((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+                       (c >= '0' && c <= '9'),
+                   NS_ERROR_NOT_AVAILABLE);
+  }
+
+  nsCOMPtr<nsIFile> root;
+  rv = mAppData->Clone(getter_AddRefs(root));
+  NS_ENSURE_SUCCESS(rv, rv);
+#  if !defined(XP_UNIX) || defined(XP_MACOSX)
+  rv = root->AppendNative("Background Tasks Profiles"_ns);
+  NS_ENSURE_SUCCESS(rv, rv);
+#  endif
+  nsCOMPtr<nsIFile> file;
+  rv = root->Clone(getter_AddRefs(file));
+  NS_ENSURE_SUCCESS(rv, rv);
+  rv = file->AppendNative(leaf);
+  NS_ENSURE_SUCCESS(rv, rv);
+  for (nsIFile* directory : {root.get(), file.get()}) {
+    bool isLink;
+    rv = directory->IsSymlink(&isLink);
+    NS_ENSURE_SUCCESS(rv, rv);
+    NS_ENSURE_TRUE(!isLink, NS_ERROR_NOT_AVAILABLE);
+    bool isDir;
+    rv = directory->IsDirectory(&isDir);
+    NS_ENSURE_SUCCESS(rv, rv);
+    NS_ENSURE_TRUE(isDir, NS_ERROR_NOT_AVAILABLE);
+  }
+
+  // Resolve existing ancestors too when a registered browsing path is missing.
+  auto normalizePath = NormalizeCatalogPath;
+  nsCOMPtr<nsIFile> canonicalRoot;
+  rv = normalizePath(root, getter_AddRefs(canonicalRoot));
+  NS_ENSURE_SUCCESS(rv, rv);
+  root = canonicalRoot;
+  nsCOMPtr<nsIFile> canonicalFile;
+  rv = normalizePath(file, getter_AddRefs(canonicalFile));
+  NS_ENSURE_SUCCESS(rv, rv);
+  file = canonicalFile;
+  bool contains;
+  rv = root->Contains(file, &contains);
+  NS_ENSURE_SUCCESS(rv, rv);
+  NS_ENSURE_TRUE(contains, NS_ERROR_NOT_AVAILABLE);
+  nsCOMPtr<nsIFile> parent;
+  rv = file->GetParent(getter_AddRefs(parent));
+  NS_ENSURE_SUCCESS(rv, rv);
+  NS_ENSURE_TRUE(parent, NS_ERROR_NOT_AVAILABLE);
+  bool equals;
+  rv = parent->Equals(root, &equals);
+  NS_ENSURE_SUCCESS(rv, rv);
+  NS_ENSURE_TRUE(equals, NS_ERROR_NOT_AVAILABLE);
+  // Include the path itself and volume roots in canonical ancestry checks.
+  auto isAncestor = IsCatalogAncestor;
+  for (nsToolkitProfile* profile : mProfiles) {
+    for (nsIFile* known : {profile->mRootDir.get(), profile->mLocalDir.get()}) {
+      NS_ENSURE_TRUE(known, NS_ERROR_NOT_AVAILABLE);
+      nsCOMPtr<nsIFile> directory;
+      rv = normalizePath(known, getter_AddRefs(directory));
+      NS_ENSURE_SUCCESS(rv, rv);
+      rv = isAncestor(file, directory, &contains);
+      NS_ENSURE_SUCCESS(rv, rv);
+      NS_ENSURE_TRUE(!contains, NS_ERROR_NOT_AVAILABLE);
+      rv = isAncestor(directory, file, &contains);
+      NS_ENSURE_SUCCESS(rv, rv);
+      NS_ENSURE_TRUE(!contains, NS_ERROR_NOT_AVAILABLE);
+    }
+  }
+  file.forget(aResult);
+  return NS_OK;
+#endif
+}
