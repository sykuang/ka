+
+RefPtr<PBrowserParent::ProduceDisplayListPromise>
+BrowserParent::ProduceDisplayListForCurrentDimensions(
+    uint64_t aExpectedInnerWindowId) {
+  auto refuse = []() {
+    return ProduceDisplayListPromise::CreateAndReject(
+        ResponseRejectReason::SendError, __func__);
+  };
+  if (mIsDestroyed || !CanSend() || !mUpdatedDimensions ||
+      !aExpectedInnerWindowId || !mFrameElement ||
+      !mFrameElement->IsInComposedDoc() || !mBrowsingContext) {
+    return refuse();
+  }
+  nsCOMPtr<nsIWidget> widget = GetWidget();
+  auto* global = mBrowsingContext->GetCurrentWindowGlobal();
+  RefPtr<nsFrameLoader> frameLoader = GetFrameLoader();
+  const auto dimensions = mDimensions;
+  const auto defaultScale = mDefaultScale;
+  const auto desktopScale = mDesktopToDeviceScale;
+  if (!widget || widget->Destroyed() || !global || !global->CanSend() ||
+      !global->IsCurrentGlobal() ||
+      global->GetBrowsingContext() != mBrowsingContext ||
+      global->GetBrowserParent() != this ||
+      global->InnerWindowId() != aExpectedInnerWindowId || !frameLoader ||
+      frameLoader->GetOwnerContent() != mFrameElement ||
+      frameLoader->GetExtantBrowsingContext() != mBrowsingContext ||
+      frameLoader->GetBrowserParent() != this || dimensions.width <= 0 ||
+      dimensions.height <= 0 || mRect.Width() <= 0 || mRect.Height() <= 0 ||
+      !std::isfinite(defaultScale.scale) ||
+      defaultScale.scale <= 0 || !std::isfinite(desktopScale.scale) ||
+      desktopScale.scale <= 0 ||
+      widget->GetDefaultScale() != defaultScale ||
+      widget->GetDesktopToDeviceScale() != desktopScale) {
+    return refuse();
+  }
+  const DimensionInfo carried = GetDimensionInfo();
+  return SendProduceDisplayList(carried, aExpectedInnerWindowId,
+                                defaultScale.scale, desktopScale.scale);
 }
 
