     const { ObjectUtils } = ChromeUtils.importESModule(
       "resource://gre/modules/ObjectUtils.sys.mjs"
     );
+
+    add_task(async function test_expected_sha256_raw_read_binding() {
+      const path = PathUtils.join(PathUtils.tempDir, "test_ioutils_expected_sha256.tmp");
+      const text = '{"bound":true,"value":"raw bytes"}';
+      const bytes = new TextEncoder().encode(text);
+      const wrong = "0".repeat(64);
+      try {
+        await IOUtils.write(path, bytes);
+        const decodedSHA256 = await IOUtils.computeHexDigest(path, "sha256");
+        for (const compress of [false, true]) {
+          await IOUtils.write(path, bytes, { compress });
+          const expectedSHA256 = await IOUtils.computeHexDigest(path, "sha256");
+          Assert.notEqual(expectedSHA256, wrong);
+          const options = { decompress: compress, expectedSHA256 };
+          ok(bytesEqual(await IOUtils.read(path, options), bytes), "read verifies raw bytes before decompression");
+          is(await IOUtils.readUTF8(path, options), text, "readUTF8 verifies raw bytes before decoding");
+          Assert.deepEqual(await IOUtils.readJSON(path, options), JSON.parse(text), "readJSON verifies raw bytes before parsing");
+          for (const method of ["read", "readUTF8", "readJSON"]) {
+            await Assert.rejects(
+              IOUtils[method](path, { ...options, expectedSHA256: wrong }),
+              /NotReadableError: .*SHA-256 mismatch/,
+              `${method} rejects a different complete raw preimage`
+            );
+            Assert.deepEqual(
+              await IOUtils[method](path, { decompress: compress, expectedSHA256: null }),
+              await IOUtils[method](path, { decompress: compress }),
+              `${method} null preserves the default`
+            );
+            for (const malformed of ["", "a".repeat(63), "a".repeat(65), "A".repeat(64), "g".repeat(64), ` ${expectedSHA256}`, "\uFF10".repeat(64)]) {
+              await Assert.rejects(
+                IOUtils[method](path, { ...options, expectedSHA256: malformed }),
+                /DataError: .*expectedSHA256 must be 64 lowercase hex characters/,
+                `${method} refuses noncanonical digest without normalizing it`
+              );
+            }
+            await Assert.rejects(
+              IOUtils[method](path, { ...options, maxFileBytes: 0 }),
+              /NotReadableError: .*file exceeds maxFileBytes/,
+              `${method} retains raw allocation budget`
+            );
+            if (compress) {
+              await Assert.rejects(
+                IOUtils[method](path, { ...options, maxDecompressedBytes: 0 }),
+                /NotReadableError: .*output exceeds maxDecompressedBytes/,
+                `${method} retains decoded allocation budget`
+              );
+            }
+          }
+          if (compress) {
+            Assert.notEqual(decodedSHA256, expectedSHA256);
+            await Assert.rejects(IOUtils.read(path, { ...options, expectedSHA256: decodedSHA256 }), /NotReadableError: .*SHA-256 mismatch/, "decoded digest cannot bind compressed raw bytes");
+          }
+          for (const partial of [{ offset: 1 }, { maxBytes: 0 }, { maxBytes: 1 }, { maxBytes: bytes.length + 100 }]) {
+            await Assert.rejects(
+              IOUtils.read(path, { ...options, ...partial }),
+              /DataError: .*expectedSHA256 requires a complete read/,
+              "expected digest refuses offset and every maxBytes before the zero fast path"
+            );
+          }
+        }
+        for (const invalid of [Uint8Array.of(255), new TextEncoder().encode("not JSON")]) {
+          await IOUtils.write(path, invalid);
+          for (const method of ["readUTF8", "readJSON"]) {
+            await Assert.rejects(IOUtils[method](path, { expectedSHA256: wrong }), /NotReadableError: .*SHA-256 mismatch/, "digest mismatch precedes UTF8 and JSON decoding");
+          }
+          await Assert.rejects(IOUtils.read(path, { decompress: true, expectedSHA256: wrong }), /NotReadableError: .*SHA-256 mismatch/, "digest mismatch precedes MozLZ4 decoding");
+        }
+        await IOUtils.write(path, new Uint8Array());
+        const expectedSHA256 = await IOUtils.computeHexDigest(path, "sha256");
+        is((await IOUtils.read(path, { expectedSHA256, maxFileBytes: 0 })).length, 0, "empty file has a verified complete raw buffer");
+        is(await IOUtils.readUTF8(path, { expectedSHA256 }), "", "empty UTF8 is verified");
+        await Assert.rejects(IOUtils.readJSON(path, { expectedSHA256 }), /SyntaxError/, "matching empty file still uses existing JSON parser");
+        for (const method of ["read", "readUTF8", "readJSON"]) {
+          await Assert.rejects(IOUtils[method](path, { expectedSHA256: wrong }), /NotReadableError: .*SHA-256 mismatch/, `${method} verifies even zero raw bytes`);
+        }
+      } finally {
+        await cleanup(path);
+      }
+    });
 
