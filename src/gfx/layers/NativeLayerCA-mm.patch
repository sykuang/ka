+bool NativeLayerRootCA::StartStagingObservation(StagingObserver aObserver,
+                                               void* aContext) {
+  MutexAutoLock lock(mMutex);
+  if (!aObserver || !aContext || mStagingObserver) return false;
+  mStagingObserver = aObserver;
+  mStagingContext = aContext;
+  return true;
+}
+
+void NativeLayerRootCA::StopStagingObservation(void* aContext) {
+  MutexAutoLock lock(mMutex);
+  if (mStagingContext != aContext) return;
+  mStagingObserver = nullptr;
+  mStagingContext = nullptr;
+}
