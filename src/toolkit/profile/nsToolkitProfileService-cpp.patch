+static nsresult NormalizeCatalogPath(nsIFile* aPath, nsIFile** aCanonical) {
+  nsCOMPtr<nsIFile> path;
+  nsresult rv = aPath->Clone(getter_AddRefs(path));
+  NS_ENSURE_SUCCESS(rv, rv);
+  nsTArray<nsString> missingLeaves;
+  for (;;) {
+    bool isDir;
+    rv = path->IsDirectory(&isDir);
+    if (rv != NS_ERROR_FILE_NOT_FOUND) {
+      NS_ENSURE_SUCCESS(rv, rv);
+      NS_ENSURE_TRUE(isDir, NS_ERROR_NOT_AVAILABLE);
+      break;
+    }
+    nsString missingLeaf;
+    rv = path->GetLeafName(missingLeaf);
+    NS_ENSURE_SUCCESS(rv, rv);
+    missingLeaves.AppendElement(missingLeaf);
+    nsCOMPtr<nsIFile> parent;
+    rv = path->GetParent(getter_AddRefs(parent));
+    NS_ENSURE_SUCCESS(rv, rv);
+    NS_ENSURE_TRUE(parent, NS_ERROR_NOT_AVAILABLE);
+    path = parent;
+  }
+#  ifdef XP_WIN
+  // nsIFile::IsSymlink is unimplemented on Windows; refuse reparse ancestry.
+  nsCOMPtr<nsIFile> ancestor = path;
+  while (ancestor) {
+    nsString nativePath;
+    rv = ancestor->GetPath(nativePath);
+    NS_ENSURE_SUCCESS(rv, rv);
+    DWORD attributes = GetFileAttributesW(nativePath.get());
+    NS_ENSURE_TRUE(attributes != INVALID_FILE_ATTRIBUTES &&
+                       !(attributes & FILE_ATTRIBUTE_REPARSE_POINT),
+                   NS_ERROR_NOT_AVAILABLE);
+    nsCOMPtr<nsIFile> parent;
+    rv = ancestor->GetParent(getter_AddRefs(parent));
+    NS_ENSURE_SUCCESS(rv, rv);
+    ancestor = parent;
+  }
+#  endif
+  rv = path->Normalize();
+  NS_ENSURE_SUCCESS(rv, rv);
+  for (size_t i = missingLeaves.Length(); i > 0; --i) {
+    rv = path->Append(missingLeaves[i - 1]);
+    NS_ENSURE_SUCCESS(rv, rv);
+  }
+  path.forget(aCanonical);
+  return NS_OK;
+}
+
+static nsresult IsCatalogAncestor(nsIFile* aParent, nsIFile* aChild,
+                     bool* aResult) {
+  *aResult = false;
+  nsCOMPtr<nsIFile> cursor = aChild;
+  while (cursor) {
+    nsresult rv = cursor->Equals(aParent, aResult);
+    NS_ENSURE_SUCCESS(rv, rv);
+    if (*aResult) {
+      return NS_OK;
+    }
+    nsCOMPtr<nsIFile> parent;
+    rv = cursor->GetParent(getter_AddRefs(parent));
+    NS_ENSURE_SUCCESS(rv, rv);
+    cursor = parent;
+  }
+  return NS_OK;
+}
