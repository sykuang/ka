+// Qualify every existing component; only the optional registry leaf may be absent.
+static nsresult CheckRegisteredSelectionPath(nsIFile* aPath, bool aFile = false,
+                                             bool aOptional = false) {
+  nsCOMPtr<nsIFile> cursor;
+  nsresult rv = aPath->Clone(getter_AddRefs(cursor));
+  NS_ENSURE_SUCCESS(rv, rv);
+  bool leaf = true;
+  while (cursor) {
+    bool isLink = false;
+    rv = cursor->IsSymlink(&isLink);
+    if (!(leaf && aOptional && rv == NS_ERROR_FILE_NOT_FOUND)) {
+      NS_ENSURE_SUCCESS(rv, rv);
+      NS_ENSURE_TRUE(!isLink, NS_ERROR_NOT_AVAILABLE);
+    }
+    bool correctType = false;
+    rv = leaf && aFile ? cursor->IsFile(&correctType)
+                      : cursor->IsDirectory(&correctType);
+    if (!(leaf && aOptional && rv == NS_ERROR_FILE_NOT_FOUND)) {
+      NS_ENSURE_SUCCESS(rv, rv);
+      NS_ENSURE_TRUE(correctType, NS_ERROR_NOT_AVAILABLE);
+      if (leaf) {
+        bool readable;
+        rv = cursor->IsReadable(&readable);
+        NS_ENSURE_SUCCESS(rv, rv);
+        NS_ENSURE_TRUE(readable, NS_ERROR_FILE_ACCESS_DENIED);
+      }
+    }
+    nsCOMPtr<nsIFile> parent;
+    rv = cursor->GetParent(getter_AddRefs(parent));
+    NS_ENSURE_SUCCESS(rv, rv);
+    cursor = parent;
+    leaf = false;
+  }
+  return NS_OK;
+}
