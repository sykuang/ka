+static bool IsRegisteredProfileSection(const nsACString& aSection) {
+  if (!StringBeginsWith(aSection, "Profile"_ns) || aSection.Length() <= 7) {
+    return false;
+  }
+  for (uint32_t i = 7; i < aSection.Length(); ++i) {
+    if (aSection.CharAt(i) < '0' || aSection.CharAt(i) > '9') {
+      return false;
+    }
+  }
+  return true;
+}
